diff --git a/OptiScaler/upscalers/anf/ANFFeature_Dx12.cpp b/OptiScaler/upscalers/anf/ANFFeature_Dx12.cpp
new file mode 100644
index 0000000..d7a3268
--- /dev/null
+++ b/OptiScaler/upscalers/anf/ANFFeature_Dx12.cpp
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#include <pch.h>
+#include "ANFFeature_Dx12.h"
+#include <Config.h>
+#include <State.h>
+
+bool ANFFeatureDx12::InitInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters)
+{
+    LOG_FUNC();
+    if (IsInited())
+        return true;
+    auto& anf4r = ANFProxy::Get();
+    _ctx = ANFD3D12::Create(Device, &_interop);
+    if (_ctx == nullptr)
+        return false;
+    if (anf4r.upscaleInit(_ctx, DisplayWidth(), DisplayHeight(), RenderWidth(), RenderHeight()) != 0)
+    {
+        LOG_ERROR("ANF: {} (install the ANF data with scripts/install_anf.py; init failed for {}x{} -> {}x{})", anf4r.lastError(_ctx),
+                  RenderWidth(), RenderHeight(), DisplayWidth(), DisplayHeight());
+        return false;
+    }
+    LOG_INFO("ANF: ready, {}x{} -> {}x{}", RenderWidth(), RenderHeight(), DisplayWidth(), DisplayHeight());
+    SetInit(true);
+    return true;
+}
+
+anf4r_image ANFFeatureDx12::Image(ID3D12Resource* res, D3D12_RESOURCE_STATES state)
+{
+    return ANFD3D12::Image(_interop, res, state);
+}
+
+template <class T> static T* GetResource(NVSDK_NGX_Parameter* p, const char* name)
+{
+    T* r = nullptr;
+    if (p->Get(name, &r) != NVSDK_NGX_Result_Success)
+        p->Get(name, (void**) &r);
+    return r;
+}
+
+bool ANFFeatureDx12::EvaluateInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters)
+{
+    LOG_FUNC();
+    if (!IsInited() || _ctx == nullptr)
+        return false;
+    auto& anf4r = ANFProxy::Get();
+    anf4r_upscale_desc d {};
+    auto color = GetResource<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_Color);
+    auto motion = GetResource<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_MotionVectors);
+    auto depth = GetResource<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_Depth);
+    auto output = GetResource<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_Output);
+    auto exposure = AutoExposure() ? nullptr : GetResource<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_ExposureTexture);
+    if (!color || !motion || !depth || !output)
+    {
+        LOG_ERROR("ANF: missing color, motion vectors, depth or output");
+        return false;
+    }
+    if (!LowResMV())
+        LOG_WARN("ANF: display-resolution motion vectors are not supported yet");
+    // OptiScaler's evaluation contract: inputs readable by compute, the output an UAV
+    d.color = Image(color, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    d.motion = Image(motion, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    d.depth = Image(depth, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    d.exposure = Image(exposure, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    d.output = Image(output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    unsigned int rw = 0, rh = 0;
+    GetRenderResolution(InParameters, &rw, &rh);
+    d.content_width = rw;
+    d.content_height = rh;
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_X, &d.jitter_x);
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y, &d.jitter_y);
+    if (Config::Instance()->ANFFlipJitter.value_or(false))
+    {
+        d.jitter_x = -d.jitter_x;
+        d.jitter_y = -d.jitter_y;
+    }
+    if (InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_X, &d.motion_scale_x) != NVSDK_NGX_Result_Success ||
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &d.motion_scale_y) != NVSDK_NGX_Result_Success)
+    {
+        d.motion_scale_x = 1.0f;
+        d.motion_scale_y = 1.0f;
+    }
+    if (InParameters->Get(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, &d.pre_exposure) != NVSDK_NGX_Result_Success)
+        d.pre_exposure = 1.0f;
+    int reset = 0;
+    InParameters->Get(NVSDK_NGX_Parameter_Reset, &reset);
+    d.reset = reset;
+    d.depth_reversed = DepthInverted() ? 1 : 0;
+
+    VkCommandBuffer cb = VK_NULL_HANDLE;
+    if (FAILED(_interop->BeginVkCommandBufferInterop(InCommandList, &cb)) || cb == VK_NULL_HANDLE)
+    {
+        LOG_ERROR("ANF: BeginVkCommandBufferInterop failed");
+        return false;
+    }
+    const int r = anf4r.upscale(_ctx, cb, &d);
+    _interop->EndVkCommandBufferInterop(InCommandList);
+    if (r != 0)
+    {
+        LOG_ERROR("ANF: {}", anf4r.lastError(_ctx));
+        return false;
+    }
+    _frameCount++;
+    return true;
+}
+
+ANFFeatureDx12::~ANFFeatureDx12()
+{
+    if (_ctx)
+        ANFProxy::Get().destroy(_ctx);
+    if (_interop)
+        _interop->Release();
+}
diff --git a/OptiScaler/upscalers/anf/ANFFeature_Dx12.h b/OptiScaler/upscalers/anf/ANFFeature_Dx12.h
new file mode 100644
index 0000000..84effca
--- /dev/null
+++ b/OptiScaler/upscalers/anf/ANFFeature_Dx12.h
@@ -0,0 +1,31 @@
+#pragma once
+// ANF ML temporal upscaler (Apple's BBR network run by anf4r on AMD RDNA2/3/4) for D3D12 games under vkd3d-proton.
+// SPDX-License-Identifier: GPL-3.0-only
+#include <upscalers/IFeature_Dx12.h>
+#include "ANF_D3D12.h"
+
+class ANFFeatureDx12 : public IFeature_Dx12
+{
+  private:
+    anf4r_context* _ctx = nullptr;
+    ID3D12DXVKInteropDevice1* _interop = nullptr;
+    anf4r_image Image(ID3D12Resource* res, D3D12_RESOURCE_STATES state);
+
+  public:
+    feature_version Version() override { return feature_version { 1, 0, 0 }; }
+    Upscaler GetUpscalerType() const final { return Upscaler::ANF; }
+    API Api() const override { return IFeature_Dx12::Api(); }
+    bool IsWithDx12() final { return false; }
+
+    ANFFeatureDx12(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters)
+        : IFeature(InHandleId, InParameters), IFeature_Dx12(InHandleId, InParameters)
+    {
+        _initParameters = SetInitParameters(InParameters);
+        _moduleLoaded = ANFProxy::Get().module != nullptr;
+    }
+
+    bool InitInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters) override;
+    bool EvaluateInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters) override;
+
+    ~ANFFeatureDx12();
+};
diff --git a/OptiScaler/upscalers/anf/ANF_D3D12.h b/OptiScaler/upscalers/anf/ANF_D3D12.h
new file mode 100644
index 0000000..313afc7
--- /dev/null
+++ b/OptiScaler/upscalers/anf/ANF_D3D12.h
@@ -0,0 +1,69 @@
+#pragma once
+// anf4r on a vkd3d-proton D3D12 device: context creation and D3D12 resource -> Vulkan image description.
+// SPDX-License-Identifier: GPL-3.0-only
+#include "ANF_Proxy.h"
+#include "VkD3D_Interop.h"
+
+namespace ANFD3D12
+{
+inline PFN_vkGetInstanceProcAddr VulkanLoader()
+{
+    HMODULE vk = GetModuleHandleW(L"vulkan-1.dll");
+    if (vk == nullptr)
+        vk = LoadLibraryW(L"vulkan-1.dll");
+    return vk ? (PFN_vkGetInstanceProcAddr) GetProcAddress(vk, "vkGetInstanceProcAddr") : nullptr;
+}
+
+// anf4r context on the game's Vulkan device; *interop receives a reference the caller releases
+inline anf4r_context* Create(ID3D12Device* device, ID3D12DXVKInteropDevice1** interop)
+{
+    auto& anf4r = ANFProxy::Get();
+    *interop = nullptr;
+    if (anf4r.module == nullptr || device == nullptr)
+        return nullptr;
+    if (FAILED(device->QueryInterface(__uuidof(ID3D12DXVKInteropDevice1), (void**) interop)) || *interop == nullptr)
+    {
+        LOG_ERROR("ANF: needs vkd3d-proton (ID3D12DXVKInteropDevice1 unavailable)");
+        return nullptr;
+    }
+    VkInstance instance = VK_NULL_HANDLE;
+    VkPhysicalDevice physical = VK_NULL_HANDLE;
+    VkDevice vkDevice = VK_NULL_HANDLE;
+    auto gipa = VulkanLoader();
+    if (gipa == nullptr || FAILED((*interop)->GetVulkanHandles(&instance, &physical, &vkDevice)))
+    {
+        LOG_ERROR("ANF: no Vulkan handles from vkd3d-proton");
+        return nullptr;
+    }
+    auto plans = wstring_to_string(ANFProxy::Dir().wstring()) + "\\data";
+    anf4r_context* ctx = nullptr;
+    if (anf4r.create(&ctx, gipa, instance, physical, vkDevice, 0, plans.c_str()) != 0)
+    {
+        LOG_ERROR("ANF: anf4r_create: {}", anf4r.lastError(ctx));
+        anf4r.destroy(ctx);
+        return nullptr;
+    }
+    return ctx;
+}
+
+// the Vulkan image behind a D3D12 resource and its layout in the given D3D12 state
+inline anf4r_image Image(ID3D12DXVKInteropDevice1* interop, ID3D12Resource* res, D3D12_RESOURCE_STATES state)
+{
+    anf4r_image im {};
+    if (res == nullptr || interop == nullptr)
+        return im;
+    UINT64 handle = 0, offset = 0;
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    if (FAILED(interop->GetVulkanResourceInfo1(res, &handle, &offset, &format)) || handle == 0)
+        return im;
+    auto desc = res->GetDesc();
+    im.image = (VkImage) handle;
+    im.format = format;
+    im.width = (uint32_t) desc.Width;
+    im.height = desc.Height;
+    VkImageLayout layout = VK_IMAGE_LAYOUT_GENERAL;
+    interop->GetVulkanImageLayout(res, state, &layout);
+    im.layout = layout;
+    return im;
+}
+} // namespace ANFD3D12
diff --git a/OptiScaler/upscalers/anf/ANF_Proxy.h b/OptiScaler/upscalers/anf/ANF_Proxy.h
new file mode 100644
index 0000000..b89b05b
--- /dev/null
+++ b/OptiScaler/upscalers/anf/ANF_Proxy.h
@@ -0,0 +1,64 @@
+#pragma once
+// anf4r (ANF on AMD, github.com/countervolts/anf4r): loads anf4r\anf4r.dll from OptiScaler's folder.
+// SPDX-License-Identifier: GPL-3.0-only
+#include <pch.h>
+#include <Util.h>
+#include "anf4r.h"
+
+class ANFProxy
+{
+  public:
+    using PFN_create = decltype(&anf4r_create);
+    using PFN_destroy = decltype(&anf4r_destroy);
+    using PFN_upscale_init = decltype(&anf4r_upscale_init);
+    using PFN_upscale = decltype(&anf4r_upscale);
+    using PFN_interpolate_init = decltype(&anf4r_interpolate_init);
+    using PFN_interpolate = decltype(&anf4r_interpolate);
+    using PFN_last_error = decltype(&anf4r_last_error);
+
+    struct Table
+    {
+        HMODULE module = nullptr;
+        PFN_create create = nullptr;
+        PFN_destroy destroy = nullptr;
+        PFN_upscale_init upscaleInit = nullptr;
+        PFN_upscale upscale = nullptr;
+        PFN_interpolate_init interpolateInit = nullptr;
+        PFN_interpolate interpolate = nullptr;
+        PFN_last_error lastError = nullptr;
+    };
+
+    static std::filesystem::path Dir() { return Util::DllPath().parent_path() / L"anf4r"; }
+
+    static Table& Get()
+    {
+        static Table t = Load();
+        return t;
+    }
+
+  private:
+    static Table Load()
+    {
+        Table t;
+        auto path = Dir() / L"anf4r.dll";
+        t.module = LoadLibraryW(path.c_str());
+        if (t.module == nullptr)
+        {
+            LOG_ERROR("ANF: can't load {}", wstring_to_string(path.wstring()));
+            return t;
+        }
+        t.create = (PFN_create) GetProcAddress(t.module, "anf4r_create");
+        t.destroy = (PFN_destroy) GetProcAddress(t.module, "anf4r_destroy");
+        t.upscaleInit = (PFN_upscale_init) GetProcAddress(t.module, "anf4r_upscale_init");
+        t.upscale = (PFN_upscale) GetProcAddress(t.module, "anf4r_upscale");
+        t.interpolateInit = (PFN_interpolate_init) GetProcAddress(t.module, "anf4r_interpolate_init");
+        t.interpolate = (PFN_interpolate) GetProcAddress(t.module, "anf4r_interpolate");
+        t.lastError = (PFN_last_error) GetProcAddress(t.module, "anf4r_last_error");
+        if (!t.create || !t.upscale || !t.lastError)
+        {
+            LOG_ERROR("ANF: anf4r.dll is missing exports");
+            t.module = nullptr;
+        }
+        return t;
+    }
+};
diff --git a/OptiScaler/upscalers/anf/VkD3D_Interop.h b/OptiScaler/upscalers/anf/VkD3D_Interop.h
new file mode 100644
index 0000000..41ba7f4
--- /dev/null
+++ b/OptiScaler/upscalers/anf/VkD3D_Interop.h
@@ -0,0 +1,16 @@
+#pragma once
+// vkd3d-proton's D3D12 <-> Vulkan interop interface (public API of vkd3d-proton, include/vkd3d_device_vkd3d_ext.idl).
+#include <d3d12.h>
+#include <vulkan/vulkan_core.h>
+
+#include <misc/IdentifyGpu.h>   // declares ID3D12DXVKInteropDevice
+
+MIDL_INTERFACE("902d8115-59eb-4406-9518-fe00f991ee65")
+ID3D12DXVKInteropDevice1 : public ID3D12DXVKInteropDevice
+{
+    virtual HRESULT STDMETHODCALLTYPE GetVulkanResourceInfo1(ID3D12Resource* resource, UINT64* handle, UINT64* offset, VkFormat* format) = 0;
+    virtual HRESULT STDMETHODCALLTYPE CreateInteropCommandQueue(const D3D12_COMMAND_QUEUE_DESC* desc, UINT32 family, ID3D12CommandQueue** queue) = 0;
+    virtual HRESULT STDMETHODCALLTYPE CreateInteropCommandAllocator(D3D12_COMMAND_LIST_TYPE type, UINT32 family, ID3D12CommandAllocator** allocator) = 0;
+    virtual HRESULT STDMETHODCALLTYPE BeginVkCommandBufferInterop(ID3D12CommandList* list, VkCommandBuffer* buffer) = 0;
+    virtual HRESULT STDMETHODCALLTYPE EndVkCommandBufferInterop(ID3D12CommandList* list) = 0;
+};
diff --git a/OptiScaler/upscalers/anf/anf4r.h b/OptiScaler/upscalers/anf/anf4r.h
new file mode 100644
index 0000000..d210379
--- /dev/null
+++ b/OptiScaler/upscalers/anf/anf4r.h
@@ -0,0 +1,72 @@
+/* anf4r: Qualcomm Adreno Neural Fusion super resolution (2x) and frame generation on non-Adreno Vulkan devices.
+ * Shape-compatible with m4r's API so the OptiScaler backend is a rename of m4r's. The caller owns the Vulkan device; anf4r records
+ * its passes into the caller's command buffer. Images are passed as VkImage + format + size + current layout; anf4r moves them to
+ * GENERAL (or a transfer layout) around its passes and back. Data (<data_dir>): shaders/*.spv (our kernels), spirv/*.bin (vendor FG shaders),
+ * modelzoo/ (vendor weights) -- produced by scripts/install_anf.py.
+ * SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+#include <stdint.h>
+#ifndef VK_NO_PROTOTYPES
+#define VK_NO_PROTOTYPES
+#endif
+#include <vulkan/vulkan.h>
+
+#ifdef _WIN32
+#define ANF4R_API __declspec(dllexport)
+#else
+#define ANF4R_API __attribute__((visibility("default")))
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct anf4r_context anf4r_context;
+
+typedef struct anf4r_image {
+    VkImage image;          /* VK_NULL_HANDLE = not provided */
+    VkFormat format;
+    uint32_t width, height;
+    VkImageLayout layout;   /* layout when the commands run; VK_IMAGE_LAYOUT_UNDEFINED is treated as GENERAL */
+} anf4r_image;
+
+typedef struct anf4r_upscale_desc {
+    anf4r_image color, depth, motion, exposure /* unused by ANF */, output;
+    uint32_t content_width, content_height;  /* rendered area of color/depth/motion (top-left aligned) */
+    float jitter_x, jitter_y;                /* sub-pixel sample offset the frame was rendered with (pixels, image coordinates: x right, y down, as in
+                                                (m4r); anf4r converts to ANF's y-up jitterOffset). Expected in [-0.5,0.5]. */
+    float motion_scale_x, motion_scale_y;    /* converts motion texture values to pixels (previous - current) */
+    float pre_exposure;                      /* unused (the ANF tonemap assumes 1) */
+    int reset, depth_reversed;
+} anf4r_upscale_desc;
+
+typedef struct anf4r_interpolate_desc {
+    anf4r_image color, prev_color, depth, motion, output;  /* color/output at output size; depth/motion at input size */
+    float motion_scale_x, motion_scale_y;                  /* to input pixels, previous - current */
+    float delta_time, near_plane, far_plane;
+    int depth_reversed, reset;
+} anf4r_interpolate_desc;
+
+typedef struct anf4r_framegen_desc {
+    anf4r_image backbuffer, depth, motion;
+    float motion_scale_x, motion_scale_y;   /* to render pixels, previous - current */
+    float delta_time, near_plane, far_plane;
+    int depth_reversed, reset;
+} anf4r_framegen_desc;
+
+ANF4R_API int anf4r_create(anf4r_context** out, PFN_vkGetInstanceProcAddr get_instance_proc_addr, VkInstance instance,
+                           VkPhysicalDevice physical, VkDevice device, uint32_t queue_family, const char* data_dir);
+ANF4R_API void anf4r_destroy(anf4r_context* ctx);
+/* 0 on success. ANF SR is fixed 2.0x: out_w/out_h must equal 2*in. max_in_* is the largest content size that will be used. */
+ANF4R_API int anf4r_upscale_init(anf4r_context* ctx, uint32_t out_w, uint32_t out_h, uint32_t max_in_w, uint32_t max_in_h);
+ANF4R_API int anf4r_upscale(anf4r_context* ctx, VkCommandBuffer cb, const anf4r_upscale_desc* desc);
+ANF4R_API int anf4r_interpolate_init(anf4r_context* ctx, uint32_t out_w, uint32_t out_h, uint32_t in_w, uint32_t in_h);
+ANF4R_API int anf4r_interpolate(anf4r_context* ctx, VkCommandBuffer cb, const anf4r_interpolate_desc* desc);
+/* Returns 1 when the generated frame was written to desc->backbuffer, 0 = nothing generated (first frame / reset), negative = error. */
+ANF4R_API int anf4r_framegen_capture(anf4r_context* ctx, VkCommandBuffer cb, const anf4r_framegen_desc* desc);
+ANF4R_API int anf4r_framegen_restore(anf4r_context* ctx, VkCommandBuffer cb, const anf4r_image* backbuffer);
+ANF4R_API const char* anf4r_last_error(anf4r_context* ctx);
+
+#ifdef __cplusplus
+}
+#endif
