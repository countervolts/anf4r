#version 450
// anf4r: optional output stabiliser (NOT part of Qualcomm's pipeline; see docs/divergences.md D8).
// ANF's own recurrent history is untouched. This pass keeps a second history of ANF's tonemapped output and blends it with the current
// result: s = mix(cur, clamp(reproject(s_prev), min3x3(cur), max3x3(cur)), beta). The clamp bounds the history to what the current
// frame's neighbourhood supports (no ghosting beyond it); reprojection uses the same MV warp as ANF. Then the inverse tonemap.
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(constant_id = 0) const float TM_MAX = 0.9995;
layout(set = 0, binding = 0) uniform texture2D texCur;        // ANF tonemapped output of this frame (HR)
layout(set = 0, binding = 1) uniform texture2D texMV;         // MV in LR pixels (curr - prev)
layout(set = 0, binding = 2) uniform texture2D texPrevStab;   // previous stabilised tonemapped frame (HR)
layout(set = 0, binding = 3) uniform sampler sampBorder;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D imgStab;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D imgOut;
layout(push_constant) uniform PC { int hrW; int hrH; float beta; float preExposure; } pc;
shared vec3 tile[10][10];
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 t0 = ivec2(gl_WorkGroupID.xy) * 8 - 1;
    for (int i = int(gl_LocalInvocationIndex); i < 100; i += 64) {
        ivec2 t = ivec2(i % 10, i / 10), q = clamp(t0 + t, ivec2(0), ivec2(pc.hrW - 1, pc.hrH - 1));
        tile[t.y][t.x] = texelFetch(texCur, q, 0).rgb;
    }
    barrier();
    if (p.x >= pc.hrW || p.y >= pc.hrH) return;
    ivec2 lt = ivec2(gl_LocalInvocationID.xy) + 1;
    vec3 cur = tile[lt.y][lt.x], mn = cur, mx = cur;
    for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) { vec3 n = tile[lt.y + dy][lt.x + dx]; mn = min(mn, n); mx = max(mx, n); }
    ivec2 lp = p >> 1; int k = (p.x & 1) + 2 * (p.y & 1);
    vec2 mvPx = texelFetch(texMV, lp, 0).rg;
    vec2 uv = vec2(2.0 * float(lp.x) - 2.0 * mvPx.x + 0.5 + float(k & 1), 2.0 * float(lp.y) - 2.0 * mvPx.y + 0.5 + float(k >> 1));
    vec3 h = textureLod(sampler2D(texPrevStab, sampBorder), uv / vec2(float(pc.hrW), float(pc.hrH)), 0.0).rgb;
    vec3 s = mix(cur, clamp(h, mn, mx), pc.beta);
    imageStore(imgStab, p, vec4(s, 1.0));
    vec3 tt = clamp(s, 0.0, TM_MAX); float m = max(tt.x, max(tt.y, tt.z));
    vec3 lin = (tt * pc.preExposure) / (1.0 - m); lin *= lin;
    imageStore(imgOut, p, vec4(lin, 1.0));
}
