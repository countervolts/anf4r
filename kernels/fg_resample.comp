#version 450
// anf4r: bring the game's render-size depth and motion vectors to the FG size (ANF FG needs FULL-size inputs).
// Nearest sampling. Motion: texture value * scale = pixels (previous - current, render size) -> uv units (previous - current), the FG convention.
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform texture2D texDepth;
layout(set = 0, binding = 1) uniform texture2D texMotion;
layout(set = 0, binding = 2, r32f) uniform writeonly image2D imgDepth;
layout(set = 0, binding = 3, rg16f) uniform writeonly image2D imgMotion;
layout(push_constant) uniform PC { vec2 mvScale; vec2 renderSize; ivec2 outSize; } pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.outSize.x || p.y >= pc.outSize.y) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.outSize);
    ivec2 dd = min(ivec2(uv * vec2(textureSize(texDepth, 0))), textureSize(texDepth, 0) - 1);
    ivec2 dm = min(ivec2(uv * vec2(textureSize(texMotion, 0))), textureSize(texMotion, 0) - 1);
    imageStore(imgDepth, p, vec4(texelFetch(texDepth, dd, 0).r, 0.0, 0.0, 0.0));
    vec2 mv = texelFetch(texMotion, dm, 0).rg * pc.mvScale / pc.renderSize;
    imageStore(imgMotion, p, vec4(mv, 0.0, 0.0));
}
