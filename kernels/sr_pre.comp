#version 450
// anf4r SR preprocess (reconstruction of Kernels_Hawi/preprocess_qmfnet_v2.cl; see docs/divergences.md D6).
// Per LR pixel: unpack+tonemap colour, 3x3 max-depth MV pick, warp previous HR colour/feature (2x2 HR samples),
// pack the 20-channel int8 model input (uint8-128 domain): [R G B depth][feature x4][prev R x4][prev G x4][prev B x4].
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(constant_id = 0) const int LR_W = 1;
layout(constant_id = 1) const int LR_H = 1;

layout(set = 0, binding = 0) uniform texture2D texColor;       // LR linear HDR colour (any float format; R11G11B10 decoded by HW)
layout(set = 0, binding = 1) uniform texture2D texDepth;       // LR depth, fp32, reverse-Z (larger = nearer)
layout(set = 0, binding = 2) uniform texture2D texMV;          // LR motion, rg fp16/32, uv units, no jitter
layout(set = 0, binding = 3) uniform texture2D texPrevColor;   // HR tonemapped history (RGBA16F)
layout(set = 0, binding = 4) uniform texture2D texPrevFeat;    // HR feature history (R32F)
layout(set = 0, binding = 5) uniform sampler sampBorder;       // linear, clamp-to-border (transparent black) == CLK_ADDRESS_CLAMP
layout(std430, binding = 6) writeonly buffer ModelIn { uint v[]; } mi;   // 8 words / pixel (32 B)
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D imgColorLR;   // unpacked (tonemapped) LR colour
layout(set = 0, binding = 8, rg32f) uniform writeonly image2D imgMV;   // chosen MV in LR pixels (curr - prev); sr_post re-derives the warp from it
layout(push_constant) uniform PC { float preExposure; vec2 mvScale; int depthInvert; } pc;   // mvScale: texture value -> LR pixels (curr - prev); depthInvert: forward-Z input

shared float shD[10][10];
shared vec2 shM[10][10];

float rndaz(float x) { return x >= 0.0 ? floor(x + 0.5) : ceil(x - 0.5); }
uint q8(float v) { return uint(clamp(rndaz(v * 255.0), 0.0, 255.0)) ^ 128u; }   // uint8 - 128 stored as int8 byte
vec3 tonemap(vec3 c) { vec3 s = sqrt(max(c, 0.0)); float m = max(s.x, max(s.y, s.z)); return s * (1.0 / (m + pc.preExposure)); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    // 10x10 tile of depth/MV (8x8 workgroup + 1 pixel border); out-of-frame depth = -1, MV 0 (as mm_find_max_depth_index)
    ivec2 tile0 = ivec2(gl_WorkGroupID.xy) * 8 - 1;
    for (int i = int(gl_LocalInvocationIndex); i < 100; i += 64) {
        ivec2 t = ivec2(i % 10, i / 10), q = tile0 + t; float d = -1.0; vec2 mv = vec2(0.0);
        if (q.x >= 0 && q.y >= 0 && q.x < LR_W && q.y < LR_H) { d = texelFetch(texDepth, q, 0).r; if (pc.depthInvert != 0) d = 1.0 - d; mv = texelFetch(texMV, q, 0).rg; }
        shD[t.y][t.x] = d; shM[t.y][t.x] = mv;
    }
    barrier();
    if (p.x >= LR_W || p.y >= LR_H) return;
    vec3 col = tonemap(texelFetch(texColor, p, 0).rgb);
    ivec2 lt = ivec2(gl_LocalInvocationID.xy) + 1;
    float dC = shD[lt.y][lt.x];
    // 3x3 max depth (strict >, row-major scan)
    float best = shD[lt.y - 1][lt.x - 1]; vec2 bestMV = shM[lt.y - 1][lt.x - 1];
    for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) {
        float d = shD[lt.y + dy][lt.x + dx];
        if (d > best) { best = d; bestMV = shM[lt.y + dy][lt.x + dx]; }
    }
    precise vec2 mvPx = bestMV * pc.mvScale;                           // curr - prev, LR pixels
    precise vec2 uv0 = vec2(2.0 * float(p.x) - 2.0 * mvPx.x + 0.5, 2.0 * float(p.y) - 2.0 * mvPx.y + 0.5);
    vec2 hrSize = vec2(2.0 * float(LR_W), 2.0 * float(LR_H));
    vec4 S[4]; float F[4];
    for (int k = 0; k < 4; ++k) {
        precise vec2 uv = uv0 + vec2(float(k & 1), float(k >> 1));
        S[k] = textureLod(sampler2D(texPrevColor, sampBorder), uv / hrSize, 0.0);
        F[k] = textureLod(sampler2D(texPrevFeat, sampBorder), uv / hrSize, 0.0).r;
    }
    imageStore(imgColorLR, p, vec4(col, 0.0)); imageStore(imgMV, p, vec4(mvPx, 0.0, 0.0));
    uint base = uint(p.y * LR_W + p.x) * 8u;   // 32 B/pixel: 20 channels + 12 pad bytes (zero weights in the first conv ignore them)
    mi.v[base + 0u] = q8(col.r) | (q8(col.g) << 8) | (q8(col.b) << 16) | (q8(dC) << 24);
    mi.v[base + 1u] = q8(F[0]) | (q8(F[1]) << 8) | (q8(F[2]) << 16) | (q8(F[3]) << 24);
    mi.v[base + 2u] = q8(S[0].r) | (q8(S[1].r) << 8) | (q8(S[2].r) << 16) | (q8(S[3].r) << 24);
    mi.v[base + 3u] = q8(S[0].g) | (q8(S[1].g) << 8) | (q8(S[2].g) << 16) | (q8(S[3].g) << 24);
    mi.v[base + 4u] = q8(S[0].b) | (q8(S[1].b) << 8) | (q8(S[2].b) << 16) | (q8(S[3].b) << 24);
    mi.v[base + 5u] = 0u; mi.v[base + 6u] = 0u; mi.v[base + 7u] = 0u;
}
